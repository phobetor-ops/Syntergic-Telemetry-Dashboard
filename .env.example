# ============================================================================
# SYNTERGIC TELEMETRY DASHBOARD & CLOUD SENTINEL (.env.example)
# Copy this file to .env for local execution:
#   cp .env.example .env
# In GitHub Actions, add TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID under:
#   Settings -> Secrets and variables -> Actions -> Repository secrets
# ============================================================================

# --- Telegram Bot API (for Cloud Sentinel & Real-Time RED Alerting) ---
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_telegram_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# --- Backend & Redis Configuration (Optional: runs standalone in-memory if Redis is offline) ---
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
